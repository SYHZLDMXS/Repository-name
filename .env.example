# ===== NapCat 连接 =====
# 云端 docker-compose 内用服务名 napcat；本地调试改成 ws://127.0.0.1:3001
# Koyeb 合一镜像内默认就是 127.0.0.1:3001，此项可不设
NAPCAT_WS_URL=ws://napcat:3001
# 若你在 NapCat WebUI 里给 OneBot 设了 access_token，填这里；没设就留空
NAPCAT_TOKEN=

# ===== NapCat-Docker 权限（Koyeb / 容器部署需要）=====
# NapCat-Docker 镜像要求这两个变量，设 0 即以 root 运行避免权限问题
NAPCAT_UID=0
NAPCAT_GID=0

# ===== 大模型（OpenAI 兼容接口）=====
# DeepSeek 示例，可换成智谱 / OpenAI / Kimi 等任意兼容服务
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里填入你的APIKEY
LLM_MODEL=deepseek-chat

