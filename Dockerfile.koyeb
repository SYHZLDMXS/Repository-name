# 爱丽丝 QQ 机器人 · Koyeb 单容器合一版
# 基于官方 NapCat Docker 镜像，内部用 supervisord 同时跑 NapCat + bot 两个进程。
# 这样在 Koyeb 上只需部署一个 Service 即可（napcat 与 bot 通过 127.0.0.1 通信）。
FROM mlikiowa/napcat-docker:latest

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends supervisor ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

# 单独安装 Node 22 来跑 bot（保证全局 WebSocket 可用，且与 NapCat 自带的 Node 解耦，避免版本差异）
ARG TARGETARCH=amd64
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) NODE_DIST=node-v22.11.0-linux-x64 ;; \
      arm64) NODE_DIST=node-v22.11.0-linux-arm64 ;; \
      *) echo "unsupported arch $TARGETARCH" && exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v22.11.0/${NODE_DIST}.tar.xz" -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /opt \
    && mv "/opt/${NODE_DIST}" /opt/node22 \
    && rm -f /tmp/node.tar.xz

WORKDIR /app
COPY bot.js package.json /app/
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY start_napcat.sh /app/start_napcat.sh
RUN chmod +x /app/start_napcat.sh

# 6099 = NapCat WebUI（扫码登录用，Koyeb 对外暴露此端口）
# 3001 = OneBot WebSocket（仅容器内使用，bot 连 127.0.0.1:3001，无需对外）
EXPOSE 6099 3001

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
